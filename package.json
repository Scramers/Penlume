{
  "name": "penlume",
  "productName": "Penlume",
  "version": "0.12.1",
  "private": true,
  "description": "Penlume — A quiet place to write.",
  "license": "MIT",
  "author": "Scramers",
  "repository": { "type": "git", "url": "https://github.com/scramers/Penlume.git" },
  "homepage": "https://github.com/scramers/Penlume#readme",
  "bugs": { "url": "https://github.com/scramers/Penlume/issues" },
  "engines": { "node": ">=22.12.0" },
  "main": "dist/electron/main/index.js",
  "scripts": {
    "setup:pandoc:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-pandoc.ps1",
    "prepare:vendor": "node scripts/prepare-vendor.mjs",
    "licenses:collect": "npm run prepare:vendor && node scripts/collect-licenses.mjs",
    "package:core:win": "npm run build && npm run licenses:collect && node scripts/package-core-win.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "npm run prepare:vendor && npm run build:electron && concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:desktop\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:desktop": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run clean && npm run typecheck && npm run build:electron && npm run build:renderer",
    "build:electron": "tsc -p tsconfig.electron.json && npm run build:preload",
    "build:preload": "vite build --config vite.preload.config.mts",
    "build:renderer": "npm run prepare:vendor && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && node scripts/electron-smoke.mjs",
    "test:packaged:win": "cross-env TTYPORA_PACKAGED_EXE=release-v0.12.1/win-unpacked/Penlume.exe node scripts/electron-smoke.mjs",
    "test:portable:win": "node scripts/portable-launch-smoke.mjs",
    "test:watch": "vitest",
    "package:dir": "npm run build && npm run licenses:collect && electron-builder --dir",
    "package:win": "npm run build && npm run licenses:collect && electron-builder --win nsis",
    "package:portable:win": "npm run build && npm run licenses:collect && electron-builder --win portable",
    "test:parity": "npm run build && node scripts/parity-smoke.mjs",
    "test:workspace": "npm run build && node scripts/workspace-smoke.mjs",
    "test:editor": "npm run build && node scripts/editor-history-smoke.mjs",
    "test:extensions": "npm run build && node scripts/inline-extensions-smoke.mjs",
    "test:images": "npm run build && node scripts/image-library-smoke.mjs",
    "test:production": "npm run build && node scripts/production-tools-smoke.mjs",
    "test:media": "npm run build && node scripts/media-smoke.mjs",
    "test:uploaders": "npm run build && node scripts/image-uploader-smoke.mjs",
    "test:localization": "npm run build && node scripts/localization-smoke.mjs",
    "test:editor-locale": "npm run build && node scripts/editor-locale-smoke.mjs",
    "test:tables": "npm run build && node scripts/table-tools-smoke.mjs",
    "test:table-clipboard": "npm run build && node scripts/table-clipboard-smoke.mjs",
    "test:table-hardbreak": "npm run build && node scripts/table-hardbreak-smoke.mjs",
    "test:code-math": "npm run build && node scripts/code-math-smoke.mjs",
    "test:writing-aids": "npm run build && node scripts/writing-aids-smoke.mjs",
    "test:resource-root": "npm run build && node scripts/resource-root-smoke.mjs",
    "test:image-binding": "npm run build && node scripts/image-binding-smoke.mjs",
    "test:outline": "npm run build && node scripts/outline-smoke.mjs",
    "test:outline-controls": "npm run build && node scripts/outline-controls-smoke.mjs",
    "test:image-input-preview": "npm run build && node scripts/image-input-preview-smoke.mjs",
    "test:desktop": "npm run build && node scripts/desktop-verification.mjs",
    "verify:release:win": "node scripts/verify-windows-release.mjs",
    "test:layout": "npm run build && node scripts/layout-smoke.mjs",
    "test:selection-copy": "npm run build && node scripts/selection-copy-smoke.mjs",
    "test:typography": "npm run build && node scripts/typography-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "chokidar": "^4.0.3",
    "dompurify": "^3.4.14",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.5",
    "katex": "^0.18.5",
    "marked": "^16.4.2",
    "mermaid": "^11.17.2",
    "prosemirror-search": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-inline-links": "7.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "vue": "^3.5.42",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "build": {
    "appId": "io.github.ttypora.desktop",
    "productName": "Penlume",
    "directories": {
      "output": "release-v0.12.1"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "LICENSE", "to": "licenses/Penlume-LICENSE" },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "licenses/THIRD_PARTY_NOTICES.md" },
      { "from": "THIRD_PARTY_LICENSES.txt", "to": "licenses/THIRD_PARTY_LICENSES.txt" },
      {
        "from": ".tools/pandoc/pandoc-3.12",
        "to": "tools/pandoc",
        "filter": [
          "pandoc.exe",
          "COPYRIGHT.txt",
          "COPYING.rtf",
          "MANUAL.html"
        ]
      },
      {
        "from": "src/shared/emoji-data.LICENSE",
        "to": "licenses/emoji-data.LICENSE"
      },
      {
        "from": "src/shared/markdown-character-entities.LICENSE",
        "to": "licenses/markdown-character-entities.LICENSE"
      },
      {
        "from": ".tools/pandoc/provenance.json",
        "to": "tools/pandoc/provenance.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "role": "Editor"
      }
    ]
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "decode-named-character-reference": "1.3.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
